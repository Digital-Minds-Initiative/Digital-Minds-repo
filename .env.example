# Copy this file to `.env` (cp .env.example .env) and adjust if needed.
# Every variable is validated at startup (src/server/env.ts); the app refuses to start on invalid values.
# Never commit `.env` — only this example is tracked.

# ─── Database ────────────────────────────────────────────────
# Postgres started by `docker compose up -d`.
DATABASE_URL="postgresql://dm:dm@localhost:5432/digital_minds"
# Separate database for `pnpm test:integration`. It is wiped on every run, so its name must end in `_test`.
TEST_DATABASE_URL="postgresql://dm:dm@localhost:5432/digital_minds_test"
# Host port used by docker compose. If 5432 is taken, change it here and in both URLs above.
POSTGRES_PORT=5432

# ─── Accounts ────────────────────────────────────────────────
# Comma-separated university email domains. Subdomains are accepted too:
# "uqu.edu.sa" also allows "st.uqu.edu.sa".
ALLOWED_EMAIL_DOMAINS="uqu.edu.sa"

# ─── Sign-in ─────────────────────────────────────────────────
# Where people open the app. POST/PATCH/DELETE requests to /api/v1 must come from this origin (CSRF check).
# Defaults to http://localhost:3000 outside production (so open the app at localhost, not 127.0.0.1).
# Required on a production server, e.g. "https://app.digitalmindsint.org".
APP_ORIGIN=
# Secret for the HMACs of sign-in codes and rate-limit keys (at least 32 characters). Changing it
# invalidates pending sign-in codes and resets the rate-limit counters; sessions survive it.
# Optional in development and test (a fixed development value is used). Required on a production
# server: generate one with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=
# Secret for the committee view links: the HMAC each link is looked up by, and the key its stored
# copy is encrypted with (docs/adr/0023-committee-view-link.md). Defaults to AUTH_SECRET, so it
# only needs its own value if you want to rotate one of the two without invalidating the other —
# changing it invalidates every view link, and officers then create new ones.
VIEW_LINK_SECRET=
# Which request header holds the client IP, for the per-IP rate limits on sign-in and on the
# public committee view.
# "none" trusts no header and turns the per-IP limits off; the per-email and per-token ones still apply.
# Unset means "none" in development; a production server refuses to start until it is set (a header or "none").
# Only name a header that your reverse proxy sets or appends to, otherwise clients can forge it:
# e.g. "x-forwarded-for" (the last entry is used), "x-real-ip", "cf-connecting-ip".
CLIENT_IP_HEADER=none

# ─── Email ───────────────────────────────────────────────────
# Without RESEND_API_KEY, emails (and sign-in codes) are printed to the `pnpm dev` console instead of sent.
# Both are required on a production server.
RESEND_API_KEY=
# Sender, e.g. "Digital Minds <no-reply@auth.digitalmindsint.org>".
EMAIL_FROM=

# ─── Development only ────────────────────────────────────────
# Lets you act as any seeded user (header dropdown in the dashboard, or the X-Dev-Actor header).
# Only honoured by `pnpm dev` and tests. A production server refuses to start when this is true.
DEV_ACTOR_SWITCHER=true

# "enabled" runs the whole frontend against MSW mocks; no database needed. Restart `pnpm dev` after changing.
# Ignored by production builds.
NEXT_PUBLIC_API_MOCKING=disabled
