{
  "name": "digital-minds",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Minds — the platform for the tech student clubs at Umm Al-Qura University.",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.10.1 <13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db-guarded.ts migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/db-guarded.ts migrate reset --force && prisma db seed",
    "db:studio": "tsx scripts/db-guarded.ts studio",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "admin:grant": "tsx scripts/admin-grant.ts",
    "measure:bulk": "tsx scripts/measure-bulk.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@vercel/functions": "3.11.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@next/env": "16.4.5",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-themes": "10.6.6",
    "@storybook/nextjs-vite": "10.6.6",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-storybook": "10.6.6",
    "fflate": "0.8.3",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "msw": "3.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "read-excel-file": "9.3.14",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
