// Digital Minds — phase one data model.
// The reasoning behind the non-obvious parts is in docs/adr/0003-data-model.md and
// docs/adr/0004-points-ledger.md. Read them before changing relations or delete behaviour.
//
// Hand-written CHECK constraints live in prisma/migrations/*_init/migration.sql
// (Prisma does not model them, and never drops them).

generator client {
  provider     = "prisma-client"
  output       = "../src/server/db/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql" // the URL comes from prisma.config.ts
}

enum ClubRole {
  MEMBER
  CLUB_OFFICER
}

enum CommitteeRole {
  MEMBER
  LEAD
}

/// A role as role history records it. MEMBER is the absence of a role and is shared by both
/// columns, so one table covers both kinds: a club change is MEMBER↔CLUB_OFFICER, a committee
/// change MEMBER↔LEAD (a CHECK constraint keeps the pair and the target consistent).
enum GrantableRole {
  MEMBER
  CLUB_OFFICER
  LEAD
}

enum PointTransactionStatus {
  ACTIVE
  CANCELLED
}

/// How the members of an export were chosen (docs/adr/0025-members-export.md).
enum MemberExportSelection {
  /// Every member the list's filters matched.
  ALL
  /// Members ticked in the table, each checked against the same filters.
  IDS
}

/// What a full admin deleted (docs/adr/0015-archive-instead-of-delete.md, ADR 0026).
enum DeletionKind {
  CLUB
  COMMITTEE
  PERSON
}

enum PointRevisionAction {
  UPDATED
  CANCELLED
}

/// One account per person. Admins can create the row before the person registers;
/// registration links to it by `uniEmail` and sets `registeredAt`.
/// It holds only what identifies the person to every club (name, university email). Contact and
/// study details are kept per club, on Membership (docs/adr/0012-member-profiles-per-club.md).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Random, non-sequential id that is safe to expose in public links and cards.
  publicId     String    @unique @default(cuid(2))
  fullName     String
  /// Arabic-normalised copy of fullName used for search (see src/shared/lib/arabic.ts).
  searchName   String
  /// Always lower-case (CHECK constraint). The identity key for linking registration.
  /// Null only on a deleted person, which frees the address for a fresh account (ADR 0026).
  uniEmail     String?   @unique
  isFullAdmin  Boolean   @default(false)
  /// Null until the person registers themselves.
  registeredAt DateTime?
  /// Set when a full admin deleted this person's data (docs/adr/0026-person-deletion.md). The row
  /// stays, emptied, only so the history other people wrote keeps pointing at someone: a CHECK
  /// constraint keeps the name, email, roles and registration blank while this is set.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships                Membership[]               @relation("MembershipUser")
  removedMemberships         Membership[]               @relation("MembershipRemovedBy")
  createdPointTransactions   PointTransaction[]         @relation("PointTransactionCreatedBy")
  cancelledPointTransactions PointTransaction[]         @relation("PointTransactionCancelledBy")
  createdPointBatches        PointBatch[]
  pointRevisions             PointTransactionRevision[]
  roleChangesMade            RoleChange[]
  memberExports              MemberExport[]
  deletionsMade              DeletionRecord[]
  sessions                   Session[]
}

model Club {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// URL-safe stable key; also the future `data-brand` value for per-club theming.
  slug        String    @unique
  name        String    @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  committees      Committee[]
  membershipTypes MembershipType[]
  memberships     Membership[]
  pointBatches    PointBatch[]
  roleChanges     RoleChange[]
  memberExports   MemberExport[]
}

model Committee {
  id                 String    @id @default(uuid(7)) @db.Uuid
  clubId             String    @db.Uuid
  name               String
  description        String?
  /// Lookup key for the public view link: HMAC-SHA256(AUTH_SECRET, "committee-view:" + token).
  /// Null = no active link. A database leak alone gives out no working link: the token itself is
  /// not derivable from this, and the copy below needs the same secret (ADR 0023).
  viewTokenHash      String?   @unique
  /// The token, AES-256-GCM (nonce ‖ tag ‖ ciphertext), so the link can be copied again later.
  viewTokenCipher    Bytes?
  /// When the current link was created — by the first creation or by the latest renewal.
  viewTokenCreatedAt DateTime?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  club                 Club                  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  committeeMemberships CommitteeMembership[]
  roleChanges          RoleChange[]

  @@unique([clubId, name])
  // Target of composite FKs that keep child rows inside the same club.
  @@unique([id, clubId])
}

/// Descriptive membership levels defined and ordered by each club. Never used for permissions.
model MembershipType {
  id        String   @id @default(uuid(7)) @db.Uuid
  clubId    String   @db.Uuid
  name      String
  /// Display order inside the club, ascending.
  order     Int      @db.SmallInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club        Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([clubId, name])
  @@unique([id, clubId])
  @@index([clubId, order])
}

/// A person's membership in one club ("member" in the API). Soft-deleted via `removedAt`.
model Membership {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  clubId           String    @db.Uuid
  membershipTypeId String    @db.Uuid
  role             ClubRole  @default(MEMBER)
  /// This club's copy of the person's contact and study details. Other clubs never see it.
  personalEmail    String?
  phone            String?
  college          String?
  major            String?
  level            Int?      @db.SmallInt
  /// Set when the person is removed from the club. A removed membership grants nothing.
  removedAt        DateTime?
  removedById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                 User                  @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  club                 Club                  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  /// Composite FK: the type must belong to the same club.
  membershipType       MembershipType        @relation(fields: [membershipTypeId, clubId], references: [id, clubId], onDelete: Restrict)
  removedBy            User?                 @relation("MembershipRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)
  committeeMemberships CommitteeMembership[]
  roleChanges          RoleChange[]

  @@unique([userId, clubId])
  @@unique([id, clubId])
  @@index([clubId, removedAt])
  @@index([membershipTypeId])
}

/// Membership in one committee of the same club. Soft-deleted so points history survives.
model CommitteeMembership {
  id           String        @id @default(uuid(7)) @db.Uuid
  membershipId String        @db.Uuid
  committeeId  String        @db.Uuid
  /// Denormalised; the composite FKs guarantee membership and committee are in this club.
  clubId       String        @db.Uuid
  role         CommitteeRole @default(MEMBER)
  removedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  membership        Membership         @relation(fields: [membershipId, clubId], references: [id, clubId], onDelete: Restrict)
  committee         Committee          @relation(fields: [committeeId, clubId], references: [id, clubId], onDelete: Restrict)
  pointTransactions PointTransaction[]

  @@unique([membershipId, committeeId])
  @@unique([id, committeeId, clubId])
  @@index([committeeId, removedAt])
  @@index([clubId])
}

/// Ledger entry. Never deleted: cancelling sets status CANCELLED and records a revision.
model PointTransaction {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  committeeMembershipId String                 @db.Uuid
  /// Denormalised scope keys, FK-checked against the committee membership.
  committeeId           String                 @db.Uuid
  clubId                String                 @db.Uuid
  /// Signed: positive adds, negative deducts. Never zero (CHECK constraint).
  amount                Int
  reason                String
  /// Date of the activity (Asia/Riyadh calendar). Period filters use this, never createdAt.
  workDate              DateTime               @db.Date
  status                PointTransactionStatus @default(ACTIVE)
  /// Groups the rows written by one bulk-create request; null for a single add.
  batchId               String?                @db.Uuid
  createdById           String                 @db.Uuid
  cancelledAt           DateTime?
  cancelledById         String?                @db.Uuid
  cancellationReason    String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  committeeMembership CommitteeMembership        @relation(fields: [committeeMembershipId, committeeId, clubId], references: [id, committeeId, clubId], onDelete: Restrict)
  /// Composite FK: a batch can never span clubs. Not enforced while batchId is null (MATCH SIMPLE).
  batch               PointBatch?                @relation(fields: [batchId, clubId], references: [id, clubId], onDelete: Restrict)
  createdBy           User                       @relation("PointTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy         User?                      @relation("PointTransactionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  revisions           PointTransactionRevision[]

  @@index([committeeMembershipId, status, workDate])
  @@index([committeeId, status, workDate])
  @@index([clubId, status, workDate])
  @@index([batchId])
}

/// One bulk-points request (docs/adr/0022-bulk-points.md). Its id is the key the client sends,
/// so inserting it is what makes a resend a replay instead of a second set of transactions: the
/// primary key is the uniqueness, and Postgres makes two simultaneous inserts of the same key
/// wait for each other. Kept for good — the transactions point at it, and the UI shows it as
/// "added together on …".
model PointBatch {
  /// The client-generated batchId. Not a server default: the client owns this value.
  id          String   @id @db.Uuid
  clubId      String   @db.Uuid
  /// The committee every row is in, or null when the batch spans a club's committees.
  committeeId String?  @db.Uuid
  /// SHA-256 of the canonical request, so the same key with a different request is refused
  /// instead of silently replayed. Null for batches not made through the API (the demo seed).
  requestHash String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  club         Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  transactions PointTransaction[]

  // Target of the composite FK from PointTransaction that keeps a batch inside one club.
  @@unique([id, clubId])
  @@index([clubId, createdAt])
}

/// Immutable audit row for every edit or cancel, holding the values *before* the change.
/// Append-only, so it has createdAt but no updatedAt.
model PointTransactionRevision {
  id               String                 @id @default(uuid(7)) @db.Uuid
  transactionId    String                 @db.Uuid
  action           PointRevisionAction
  previousAmount   Int
  previousReason   String
  previousWorkDate DateTime               @db.Date
  previousStatus   PointTransactionStatus
  changedById      String                 @db.Uuid
  createdAt        DateTime               @default(now())

  transaction PointTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  changedBy   User             @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt])
}

/// Append-only record of every real grant and revoke of a club-officer or committee-lead role
/// (docs/adr/0018-granting-roles.md). Never updated and never deleted, so — like
/// PointTransactionRevision — it has createdAt and no updatedAt.
///
/// It records explicit role changes only. A role cleared because someone was removed from a
/// committee or from the club writes no row here; that is visible through `removedAt` instead.
model RoleChange {
  id           String        @id @default(uuid(7)) @db.Uuid
  clubId       String        @db.Uuid
  /// Null for a club-officer change; set for a committee-lead change.
  committeeId  String?       @db.Uuid
  /// Whose role changed. Memberships are never hard-deleted, so this always resolves.
  membershipId String        @db.Uuid
  /// Who made the change. A full admin need not be a member of the club.
  changedById  String        @db.Uuid
  previousRole GrantableRole
  newRole      GrantableRole
  createdAt    DateTime      @default(now())

  club       Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  /// Composite FKs, as everywhere below Club: both rows are in this club. `committeeId` is
  /// nullable, and Postgres skips a composite foreign key whose columns are not all set, which
  /// is exactly the club-level case.
  membership Membership @relation(fields: [membershipId, clubId], references: [id, clubId], onDelete: Restrict)
  committee  Committee? @relation(fields: [committeeId, clubId], references: [id, clubId], onDelete: Restrict)
  changedBy  User       @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([clubId, createdAt])
  @@index([membershipId, createdAt])
}

/// Append-only: one row per members export that produced a file (docs/adr/0025-members-export.md).
/// It records who took which data out of the platform, never the data itself — no names, no
/// contact details, and not even the search text, only that a search narrowed the list.
model MemberExport {
  id            String                @id @default(uuid(7)) @db.Uuid
  clubId        String                @db.Uuid
  exportedById  String                @db.Uuid
  selection     MemberExportSelection
  /// IDS only: how many members were ticked (CHECK: set exactly for IDS, and equal to rowCount).
  selectedCount Int?
  /// The list filters and sort the file was built with, the search text replaced by `search: true`.
  filters       Json
  /// The exported columns, in the file's order (CHECK: at least one).
  columns       String[]
  /// Members in the file (CHECK: 0..5000).
  rowCount      Int
  createdAt     DateTime              @default(now())

  club       Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  exportedBy User @relation(fields: [exportedById], references: [id], onDelete: Restrict)

  @@index([clubId, createdAt])
  @@index([exportedById, createdAt])
}

/// Append-only: one row per full-admin delete (docs/adr/0015-archive-instead-of-delete.md). It
/// keeps ids and counts only — never a name, an email or the confirmation the admin typed — and
/// no foreign key to the deleted row, which no longer exists (or, for a person, is emptied).
model DeletionRecord {
  id          String       @id @default(uuid(7)) @db.Uuid
  kind        DeletionKind
  /// The deleted club, committee or user id.
  targetId    String       @db.Uuid
  /// The committee's club (CHECK: set exactly for COMMITTEE). No foreign key: the club may be
  /// deleted later.
  clubId      String?      @db.Uuid
  deletedById String       @db.Uuid
  /// Rows removed per table, e.g. { "pointTransactions": 340 } (CHECK: a JSON object).
  counts      Json
  createdAt   DateTime     @default(now())

  deletedBy User @relation(fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

// ─── Sign-in (docs/adr/0014-email-otp-sign-in.md) ─────────────────────────────────────────────
// These rows are short-lived and are deleted when they expire, unlike the history above.

/// A pending sign-in code. One row per email: requesting a new code replaces the previous one.
/// Keyed by an HMAC of the address, so the table holds no email addresses and no codes.
model OtpChallenge {
  /// HMAC-SHA256(AUTH_SECRET, "email:" + email), hex.
  emailHash String   @id
  /// HMAC-SHA256(AUTH_SECRET, "otp:" + email + ":" + code), hex.
  codeHash  String
  /// Wrong guesses so far; the code stops working at 5 (CHECK 0..5).
  attempts  Int      @default(0) @db.SmallInt
  /// When this code was sent; the next one can be requested 60 seconds later.
  sentAt    DateTime
  expiresAt DateTime

  @@index([expiresAt])
}

/// One signed-in browser. The cookie holds a random 256-bit token; only its SHA-256 is stored.
/// It grants an Actor only when `userId` is set and that user has registered (name step done).
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the cookie token, hex.
  tokenHash String   @unique
  /// The address the code proved (lower-case, CHECK).
  email     String
  /// Null while a new person has not entered their name yet: no User exists for them.
  userId    String?  @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window rate-limit counter. `key` is an HMAC of "<action>:<email or ip>", so no
/// addresses or IPs are stored.
model RateLimitCounter {
  key         String
  windowStart DateTime
  /// CHECK > 0
  count       Int
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
